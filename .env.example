# Shared defaults for local development
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tenkings
POSTGRES_PASSWORD=tenkings
POSTGRES_DB=tenkings
DATABASE_URL=postgresql://tenkings:tenkings@postgres:5432/tenkings

# Optional server-only Set Ops batch CLI authority. This exact capability does
# not grant access to any other admin route.
OPERATOR_API_KEY=
OPERATOR_USER_ID=
OPERATOR_API_CAPABILITIES=set-ops:batch-import

# Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyAoo8Z8JKlqJ4QLANQ7gsg785hs4_YmfRU
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=3dc7d9615e9ee4ddfba6e0f5
GOOGLE_MAPS_API_KEY=AIzaSyAoo8Z8JKlqJ4QLANQ7gsg785hs4_YmfRU

# Browser live-rip foundation
MUX_WHIP_BASE_URL=https://global-live.mux.com/api/v1/whip
GOLDEN_TICKET_ONLINE_LOCATION_ID=
GOLDEN_TICKET_BUSY_RETRY_SECONDS=20

# Shared hosted-resolver/local-station card-format authority (32+ UTF-8 bytes).
AI_GRADER_CARD_FORMAT_AUTHORITY_HMAC_KEY=
AI_GRADER_CARD_FORMAT_AUTHORITY_HMAC_KEY_ID=
SPEEDSTER_MAP_REGISTRATION_RECEIPT_HMAC_KEY=
SPEEDSTER_MAP_REGISTRATION_RECEIPT_HMAC_KEY_ID=
SPEEDSTER_COLOR_GEOMETRY_RECEIPT_HMAC_KEY=
SPEEDSTER_COLOR_GEOMETRY_RECEIPT_HMAC_KEY_ID=

# Speedster detector checkpoint authority. Production must set a stable key ID,
# a random 32+ character secret, and require detector release identity.
AI_GRADER_SPEEDSTER_DETECTION_RECEIPT_HMAC_KEY_ID=
AI_GRADER_SPEEDSTER_DETECTION_RECEIPT_HMAC_SECRET=
AI_GRADER_SPEEDSTER_DETECTION_RECEIPT_PREVIOUS_KEYS_JSON={}
AI_GRADER_SPEEDSTER_REQUIRE_DETECTOR_IDENTITY_V1=true
AI_GRADER_SPEEDSTER_DETECT_DEADLINE_MS=55000
