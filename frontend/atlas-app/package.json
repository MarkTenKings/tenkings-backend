{
  "name": "@atlas/staff-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../packages/atlas-grading-core/scripts/build.mjs && node scripts/local.mjs",
    "build": "node ../../packages/atlas-grading-core/scripts/build.mjs && node scripts/generate-database.mjs && next build && node scripts/check-boundary.mjs",
    "start": "next start -H 127.0.0.1 -p 4318",
    "test": "node ../../packages/atlas-grading-core/scripts/build.mjs && node scripts/generate-database.mjs && node --test test/*.test.mjs",
    "db:generate": "node scripts/generate-database.mjs"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@prisma/client": "5.22.0",
    "@atlas/grading-core": "workspace:*"
  },
  "devDependencies": {
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "prisma": "5.22.0"
  }
}
