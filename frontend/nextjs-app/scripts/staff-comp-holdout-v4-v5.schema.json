{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 2
    },
    "synthetic": {
      "type": "boolean"
    },
    "protocol": {
      "type": "object",
      "properties": {
        "mapping": {
          "type": "string",
          "const": "inventory-v1-v5-ui-union-20260921"
        },
        "reference_bank_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "source_ui_sha256": {
          "type": "string",
          "const": "880cc1e51d7d22061fdd5b283795052b87b1425e391d41bf19438c86f274759e"
        },
        "labeling_guide_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "build_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "model_parameters_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recognition_package_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provider_tape_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "frozen_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "labels_sealed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "outputs_unblinded_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "market_window_start": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "market_window_end": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "bootstrap_seed": {
          "type": "number",
          "const": 20260916
        },
        "bootstrap_resamples": {
          "type": "number",
          "const": 10000
        },
        "minimum_independent_families": {
          "type": "number",
          "const": 20
        },
        "independent_reviewers": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "implementers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      },
      "required": [
        "mapping",
        "reference_bank_sha256",
        "reference_roots",
        "source_ui_sha256",
        "labeling_guide_sha256",
        "source_commit",
        "build_sha256",
        "model",
        "model_parameters_sha256",
        "recognition_package_sha256",
        "reference_manifest_sha256",
        "provider_tape_sha256",
        "frozen_at",
        "labels_sealed_at",
        "outputs_unblinded_at",
        "market_window_start",
        "market_window_end",
        "bootstrap_seed",
        "bootstrap_resamples",
        "minimum_independent_families",
        "independent_reviewers",
        "implementers"
      ],
      "additionalProperties": false
    },
    "cards": {
      "minItems": 200,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "card_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "physical_card_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "family_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "category": {
            "type": "string",
            "enum": [
              "SPORTS",
              "POKEMON"
            ]
          },
          "cohort": {
            "type": "string",
            "enum": [
              "known_family",
              "new_set"
            ]
          },
          "condition": {
            "type": "string",
            "enum": [
              "raw",
              "graded"
            ]
          },
          "rarity": {
            "type": "string",
            "enum": [
              "ordinary",
              "rare",
              "numbered"
            ]
          },
          "look_alike": {
            "type": "boolean"
          },
          "provenance_roots": {
            "minItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "ground_truth": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "exact",
                  "partial",
                  "unknown"
                ]
              },
              "identity": {
                "type": "object",
                "properties": {
                  "name": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "year": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "manufacturer": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "product_set": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "card_number": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "variant": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "language": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "edition": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "name",
                  "year",
                  "manufacturer",
                  "product_set",
                  "card_number",
                  "variant",
                  "language",
                  "edition"
                ],
                "additionalProperties": false
              },
              "condition": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "raw",
                      "graded",
                      "unknown"
                    ]
                  },
                  "raw_condition_band": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "grader": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "numeric_grade": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 10
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "status",
                  "raw_condition_band",
                  "grader",
                  "numeric_grade"
                ],
                "additionalProperties": false
              },
              "review_evidence_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "status",
              "identity",
              "condition",
              "review_evidence_sha256"
            ],
            "additionalProperties": false
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "complete",
              "provider_error",
              "timeout",
              "failed_image",
              "abstained",
              "other_failure"
            ]
          },
          "market_available": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "variant_correct": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "labels": {
            "maxItems": 24,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "candidate_id": {
                  "type": "string",
                  "pattern": "^ebay:\\d{6,20}$"
                },
                "identity_condition_correct": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sold_event": {
                  "type": "string",
                  "enum": [
                    "sold",
                    "active",
                    "unknown"
                  ]
                },
                "sold_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "final_price_cents": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "currency": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "independent_sale_key": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "candidate_id",
                "identity_condition_correct",
                "sold_event",
                "sold_at",
                "final_price_cents",
                "currency",
                "independent_sale_key",
                "evidence_sha256"
              ],
              "additionalProperties": false
            }
          },
          "raw_result": {
            "anyOf": [
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          },
          "result_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "card_id",
          "physical_card_key",
          "family_id",
          "category",
          "cohort",
          "condition",
          "rarity",
          "look_alike",
          "provenance_roots",
          "ground_truth",
          "input_sha256",
          "outcome",
          "market_available",
          "variant_correct",
          "labels",
          "raw_result",
          "result_sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "protocol",
    "cards"
  ],
  "additionalProperties": false
}
