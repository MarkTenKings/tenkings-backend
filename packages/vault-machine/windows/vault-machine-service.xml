<service>
  <id>TenKingsVaultMachine</id>
  <name>Ten Kings Vault Machine</name>
  <description>One-writer local authority for the Ten Kings Vault kiosk.</description>
  <executable>%BASE%\runtime\node.exe</executable>
  <arguments>%BASE%\current\dist\cli.js</arguments>
  <workingdirectory>%BASE%\current</workingdirectory>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="15 sec" />
  <onfailure action="restart" delay="60 sec" />
  <onfailure action="none" />
  <stoptimeout>30 sec</stoptimeout>
  <log mode="roll-by-size-time"><sizeThreshold>10485760</sizeThreshold><keepFiles>14</keepFiles></log>
  <env name="NODE_ENV" value="production" />
</service>
