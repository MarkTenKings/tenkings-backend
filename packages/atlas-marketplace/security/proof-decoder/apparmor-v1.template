  # Explicit denials complement default-deny; none grants a new host path.
  deny network,
  deny capability,
  deny mount,
  deny umount,
  deny pivot_root,
  deny /{etc,home,root,run,mnt,media}/** rwklmx,
  deny /var/{run,lib}/** rwklmx,
  deny /proc/{self,thread-self,[0-9]*}/{environ,mem,root,fd}{,/**} rwklmx,
  deny /sys/fs/cgroup{,/**} rwklmx,
